PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?resource ?otherResource WHERE {
  ?resource rdf:type owl:NamedIndividual ; rdfs:label ?label .
  ?otherResource rdfs:label ?label .
  FILTER (isIRI(?resource) && isIRI(?otherResource) && STR(?resource) < STR(?otherResource))
}

